{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sard Style Lyrics",
  "version": "0.2.2",
  "identifier": "studio.kinetic.live",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sard Style Lyrics · 0.2.2",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 640,
        "backgroundColor": "#000000",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost https://lrclib.net; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ]
  }
}
